# ---------------------------------------------------------------------------
# GitHub Repository Secrets (Settings > Secrets and variables > Actions)
# ---------------------------------------------------------------------------
# ANDROID_KEYSTORE_BASE64=   # Fichier .jks ou .keystore encodé en base64 (cat release.jks | base64 -w 0)
# KEYSTORE_PASSWORD=        # Mot de passe du keystore Android
# KEY_ALIAS=                # Alias de la clé (ex: upload ou hospital_key)
# KEY_PASSWORD=             # Mot de passe de l'alias de clé
# WINDOWS_CERTIFICATE=      # Certificat .pfx Windows pour Inno Setup (encodé en base64)
# WINDOWS_CERTIFICATE_PASSWORD= # Mot de passe du certificat Windows